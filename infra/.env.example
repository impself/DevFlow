# DevFlow 本地开发环境变量样例。
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，严禁提交（宪法 III：凭据不入库）。

# ===== 数据库 =====
# 业务状态唯一权威来源（宪法 IV）
DATABASE_URL=postgres://devflow:devflow@localhost:5432/devflow?sslmode=disable

# ===== GitHub App（最小权限：Metadata:read / Contents:read / Issues:read+write）=====
GITHUB_APP_ID=
# App 私钥的本地路径（.pem），不放仓库内
GITHUB_APP_PRIVATE_KEY_PATH=
# Webhook 签名密钥（GitHub App 设置页生成）
GITHUB_WEBHOOK_SECRET=

# ===== 模型服务（阿里云 DashScope，qwen-plus 起步）=====
DASHSCOPE_API_KEY=

# ===== 服务间内部认证（Go ↔ Python 共享密钥）=====
DEVFLOW_INTERNAL_TOKEN=

# ===== 操作者 API 认证（M1 单操作者共享令牌）=====
OPERATOR_TOKEN=

# ===== 产物目录（content-addressable，相对 runner 工作目录）=====
ARTIFACT_DIR=data/artifacts

# ===== 智能层地址（runner 出站调用）=====
RUNTIME_URL=http://127.0.0.1:8100

# ===== 服务地址 =====
CONTROL_API_ADDR=:8080
RUNTIME_ADDR=:8100
